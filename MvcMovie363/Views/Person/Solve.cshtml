@{
    ViewData["Title"] = "Giải Phương Trình Bậc 2";
}

<h2>Giải Phương Trình Bậc 2</h2>

<form asp-action="Solve" asp-controller="PTB2" method="post">
    <div>
        <label for="A">Hệ số A:</label>
        <input type="number" step="any" id="A" name="A" required value="@ViewBag.A" />
    </div>
    <div>
        <label for="B">Hệ số B:</label>
        <input type="number" step="any" id="B" name="B" required value="@ViewBag.B" />
    </div>
    <div>
        <label for="C">Hệ số C:</label>
        <input type="number" step="any" id="C" name="C" required value="@ViewBag.C" />
    </div>
    <br/>
    <button type="submit">Giải Phương Trình</button>
</form>

<hr/>

@if (ViewBag.KetQua != null)
{
    <h3>Kết Quả:</h3>
    <p>Phương trình đã nhập: @(ViewBag.A)x^2 + @(ViewBag.B)x + @(ViewBag.C) = 0</p>
    
    <p>@Html.Raw(ViewBag.KetQua)</p>
}